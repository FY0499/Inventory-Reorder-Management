    {
      "parameters": {
        "jsCode": "// بيانات المخزون\nconst inventory = $('Get row(s) in sheet').all().map(item => item.json);\n\n// بيانات المبيعات\nconst sales = $('Get row(s) in sheet1').all().map(item => item.json);\n\nconst results = inventory.map(item => {\n\n  // نجيب كل عمليات البيع الخاصة بنفس المنتج\n  const productSales = sales.filter(sale => sale.sku === item.sku);\n\n  // حساب إجمالي الكمية المباعة\n  const totalSold = productSales.reduce((sum, sale) => {\n    const soldQty = Number(\n      sale.qtySold ??\n      sale.quantitySold ??\n      sale.sold ??\n      sale.sales ??\n      sale.quantity ??\n      0\n    );\n\n    return sum + soldQty;\n  }, 0);\n\n  // عدد الأيام المسجلة للمبيعات\n  const daysTracked = productSales.length || 1;\n\n  // معدل البيع اليومي\n  const avgDailySales = totalSold / daysTracked;\n\n  // عدد الأيام المتبقية قبل نفاد المخزون\n  const daysUntilStockout =\n    avgDailySales > 0\n      ? Number(item.quantity) / avgDailySales\n      : 999;\n\n  return {\n    sku: item.sku,\n    productName: item.productName,\n    currentQty: Number(item.quantity),\n    avgDailySales: Number(avgDailySales.toFixed(2)),\n    daysUntilStockout: Number(daysUntilStockout.toFixed(1))\n  };\n\n})\n\n// نرسل فقط المنتجات التي ستنفد خلال أقل من 14 يوم\n.filter(item => item.daysUntilStockout < 14);\n\nreturn results.map(item => ({\n  json: item\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "id": "a1487bed-2990-4d42-a495-ebabf22f6f37",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=أنت خبير إدارة مخزون. بناءً على البيانات التالية، اقترح كمية إعادة الطلب المناسبة واشرح السبب باختصار. أعد النتيجة كـ JSON فقط: {\"reorder_quantity\": 0, \"urgency\": \"عاجل/عادي\", \"reasoning\": \"...\"}\n\nالمنتج: {{ $json.productName }}\nالكمية الحالية: {{ $json.currentQty }}\nمعدل البيع اليومي: {{ $json.avgDailySales }}\nأيام متبقية حتى النفاذ: {{ $json.daysUntilStockout }}",
        "options": {}
      },
