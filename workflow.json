    {
      "parameters": {
        "jsCode": "// نجيب رد الـ AI Agent\nconst raw = $input.first().json.output || $input.first().json.text || '';\n\n// إزالة ```json و ``` إذا كانت موجودة\nconst cleaned = raw\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\n// تحويل الرد إلى JSON\nconst parsed = JSON.parse(cleaned);\n\n// نجيب بيانات المنتج من Code in JavaScript السابقة\nconst original = $('Code in JavaScript').first().json;\n\nreturn [\n  {\n    json: {\n      ...parsed,\n      sku: original.sku,\n      productName: original.productName,\n      daysUntilStockout: original.daysUntilStockout\n    }\n  }\n];"
      },
